{
  "name": "quant",
  "displayName": "Quant Language",
  "publisher": "grafmorkov",
  "description": "Language support for the Quant programming language.",
  "main": "extension.js",
  "version": "0.0.4",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/quant-lang/vscode-extension"
  },
  "homepage": "https://github.com/quant-lang",
  "bugs": {
    "url": "https://github.com/quant-lang/quant/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "quant",
    "language",
    "compiler",
    "syntax",
    "highlighting"
  ],
  "activationEvents": [
    "onLanguage:quant-lang"
  ],
  "contributes": {
    "languages": [
      {
        "id": "quant-lang",
        "aliases": [
          "Quant",
          "quant"
        ],
        "extensions": [
          ".qu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quant-lang",
        "scopeName": "source.quant",
        "path": "./syntaxes/quant-lang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Quant",
      "properties": {
        "quant.qudPath": {
          "type": "string",
          "default": "/usr/local/bin/qud",
          "description": "Path to the qud diagnostics executable."
        },
        "quant.qudTarget": {
          "type": "string",
          "default": "",
          "description": "Optional target passed to qud as --target."
        }
      }
    }
  }
}
